# COPLA Apptainer image
#
# Mirrors the Dockerfile. Build from the repository root (needs root, --fakeroot
# or a remote builder, depending on the cluster):
#   apptainer build --fakeroot copla.sif copla.def
#
# Run (paths are relative to the current directory, which must be visible inside
# the container; $HOME and $PWD are bound by default, add --bind for others):
#   apptainer run --cleanenv copla.sif query.fna query_output [copla.py options]
#   apptainer run --cleanenv copla.sif post-install-test
#   apptainer run --cleanenv copla.sif shell
#
# --cleanenv stops host variables (PYTHONPATH, PERL5LIB, CONDA_*, ...) from
# leaking into the container and overriding its pinned environments.

Bootstrap: docker
From: condaforge/miniforge3:24.11.3-0

%files
    copla.spec-file.txt /tmp/copla.spec-file.txt
    macsyfinder.spec-file.txt /tmp/macsyfinder.spec-file.txt
    copla.ini /opt/copla/copla.ini
    bin /opt/copla/bin
    test /opt/copla/test
    docker/copla-entrypoint.sh /usr/local/bin/copla

%environment
    export COPLA_HOME=/opt/copla
    export CONDA_EXE=/opt/conda/bin/conda
    export PATH=/opt/conda/envs/copla/bin:/opt/conda/bin:${PATH}
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    # Ignore packages in the user's ~/.local, which is bound into the container
    export PYTHONNOUSERSITE=1

%post
    set -eu
    export CONDA_EXE=/opt/conda/bin/conda

    # System X11/GL libraries expected by the 2020-era gtk3 package (pulled in by
    # graph-tool), whose post-link script fails without them; procps for parallel
    apt-get update
    apt-get install -y --no-install-recommends \
        libx11-6 libxext6 libxrender1 libxi6 libxtst6 libxrandr2 libxfixes3 \
        libxcursor1 libxdamage1 libxcomposite1 libxinerama1 libgl1 procps
    rm -rf /var/lib/apt/lists/*

    # Conda environments, built from the exact package lists used to develop COPLA
    conda create -y -q -n copla --file /tmp/copla.spec-file.txt
    conda create -y -q -n macsyfinder --file /tmp/macsyfinder.spec-file.txt
    conda clean -afy
    rm /tmp/copla.spec-file.txt /tmp/macsyfinder.spec-file.txt

    # MacSyFinder 1.0.5 (Python 2) installed into its own environment
    MACSYFINDER_VERSION=1.0.5
    MACSYVIEW_VERSION=1.0.1
    cd /opt/conda/envs/macsyfinder
    wget -q https://github.com/gem-pasteur/macsyfinder/archive/macsyfinder-${MACSYFINDER_VERSION}.tar.gz
    wget -q https://github.com/gem-pasteur/macsyview/archive/macsyview-${MACSYVIEW_VERSION}.tar.gz
    tar zxf macsyfinder-${MACSYFINDER_VERSION}.tar.gz
    tar zxf macsyview-${MACSYVIEW_VERSION}.tar.gz
    mv macsyfinder-macsyfinder-${MACSYFINDER_VERSION} src
    mv macsyview-macsyview-${MACSYVIEW_VERSION} src/macsyview
    cd src
    /opt/conda/envs/macsyfinder/bin/python setup.py build
    /opt/conda/envs/macsyfinder/bin/python setup.py install --prefix=/opt/conda/envs/macsyfinder
    cd ..
    rm -rf src ./*.tar.gz

    # ani.rb from the Enveomics collection, pinned to a fixed commit
    cd /opt/copla
    ENVEOMICS_COMMIT=8660352c0b91e553a4252cbfb54083e75e37e3f3
    wget -q -O bin/ani.rb https://raw.githubusercontent.com/lmrodriguezr/enveomics/${ENVEOMICS_COMMIT}/Scripts/ani.rb
    chmod +x bin/* /usr/local/bin/copla

    # COPLA databases (~350 MB tar). CoplaDB.fofn gets absolute paths under /opt/copla
    bin/download_Copla_databases.sh
    rm Copla_databases_latest.tar

    # The image is read-only at run time, so make sure everything is readable
    chmod -R a+rX /opt/copla /opt/conda

%runscript
    exec /usr/local/bin/copla "$@"

%test
    set -e
    . /opt/conda/etc/profile.d/conda.sh
    python3 -c 'import graph_tool, numpy, pandas'
    blastn -version | head -n 1
    plasmidfinder.py -h > /dev/null
    head -n 1 /opt/copla/databases/Copla_RS84/CoplaDB.fofn
    conda activate macsyfinder
    macsyfinder --version 2>&1 | head -n 1

%labels
    Name COPLA
    Source https://github.com/santirdnd/COPLA
